# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace_with_50_char_random_string
DEBUG=False
ALLOWED_HOSTS=your_ec2_public_ip_or_dns

# ── Database (PostgreSQL on EC2) ─────────────────────────────────────────────
USE_SQLITE3=False
DB_NAME=soundlog_stg
DB_USER=soundlog
DB_PASSWORD=replace_with_db_password

# ── Celery / Redis ───────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Spotify ──────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=replace_with_spotify_client_id
SPOTIFY_CLIENT_SECRET=replace_with_spotify_client_secret

# ── Storage (set to False for staging — uses local disk) ────────────────────
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=

# ── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=replace_with_google_maps_api_key
