[Unit]
Description=soundlog gunicorn daemon
After=network.target postgresql.service redis-server.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/soundlog
EnvironmentFile=/var/www/soundlog/.env
RuntimeDirectory=soundlog
ExecStartPre=/bin/mkdir -p /var/log/soundlog
ExecStart=/var/www/soundlog/.venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/soundlog/gunicorn.sock \
    --timeout 120 \
    --access-logfile /var/log/soundlog/access.log \
    --error-logfile /var/log/soundlog/error.log \
    soundlog.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
